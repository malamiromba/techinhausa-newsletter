{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/subscribe",
      "destination": "https://malamiromba.substack.com/embed",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
